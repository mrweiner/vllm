 from lmcache.v1.multiprocess.protocols.base import RequestType
 
 logger = init_logger(__name__)
+
+# [STORM] diagnosis instrument (P1): per-request park accounting. Maps
+# request_id -> (first-park monotonic clock, poll count). Cleared wholesale
+# past a fixed bound; entry removal happens on the park-exit line.
+_PARK_TRACE: dict[str, tuple[float, int]] = {}
+
+
+def _park_note(request_id, tag=None, verdict=None):
+    if len(_PARK_TRACE) > 4096:
+        _PARK_TRACE.clear()
+    now = time.monotonic()
+    first, polls = _PARK_TRACE.get(request_id, (now, 0))
+    if verdict is None:
+        _PARK_TRACE[request_id] = (first, polls + 1)
+        logger.info(
+            "[STORM] park %s request=%s poll=%d parked=%.1fs",
+            tag, request_id, polls + 1, now - first,
+        )
+    elif request_id in _PARK_TRACE:
+        logger.info(
+            "[STORM] park-exit %s request=%s polls=%d total=%.1fs",
+            verdict, request_id, polls, now - first,
+        )
+        _PARK_TRACE.pop(request_id, None)
 
