     def schedule(self, throttle_prefills: bool = False) -> SchedulerOutput:
+        import time as _repro_time
+        _repro_now = _repro_time.monotonic()
+        if _repro_now - getattr(self, "_repro_last", 0.0) > 5.0:
+            self._repro_last = _repro_now
+            # Raw allocator accounting, independent of every filed
+            # fix: per-block ref_cnt scan of BlockPool.blocks.
+            # held = ref_cnt>0, shared = ref_cnt>1. Attribution
+            # (round 5): the distinct block ids reachable from the
+            # running/waiting/skipped_waiting requests' block tables;
+            # unattributed = held minus attributed — restore-pinned
+            # pages and wedged-copy destinations are held but in no
+            # request table, so they show up here. usage is the same
+            # tick's get_usage() (the metric gauge's source),
+            # recorded per sample but never a gap condition.
+            _pool = self.kv_cache_manager.block_pool
+            _held_ids = set()
+            _held = _shared = _null = 0
+            for _b in _pool.blocks:
+                if _b.is_null:
+                    _null += 1
+                    continue
+                if _b.ref_cnt == 0:
