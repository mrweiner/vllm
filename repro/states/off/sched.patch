+            # staged import pins (boundary_checkpoints._pending_by_block);
+            # store pins are the bridge's in-flight task checkpoints
+            # (acquire); policy-retained bundles are the published
+            # cache entries (_by_block) the boundary policy keeps on
+            # the GPU as a matter of course; delayed frees sit in
+            # finished requests' tables awaiting the (f8-style) free.
+            # The pre-registered pin gap is restoreres+storepin+other
+            # — policyret is excluded.
+            _bc = getattr(_pool, "boundary_checkpoints", None)
